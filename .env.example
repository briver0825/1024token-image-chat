# 生成一个 RSA 私钥（PKCS#8 / PEM）后填入，供服务端解密用户前端加密后的配置。
# 例如：
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out image-chat-private.pem
# 然后把文件内容整体复制到这里，注意把换行转义成 \n，或使用支持多行 PEM 的方式注入环境变量。
IMAGE_CHAT_CONFIG_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# 可选：上游图片生成超时（毫秒），默认 180000 = 180 秒
IMAGE_CHAT_PROVIDER_TIMEOUT_MS=180000

# 可选：焚决市场数据目录。本地默认写入 ./data/image-chat-market；Docker Compose 会覆盖为 /app/data/image-chat-market。
IMAGE_CHAT_MARKET_DATA_DIR=./data/image-chat-market

# 可选：焚决市场单张图片上限（字节），默认 10485760 = 10MB
IMAGE_CHAT_MARKET_MAX_IMAGE_BYTES=10485760

# 可选：焚决市场管理员删除口令。设置后可在市场页用“管理删除”软删除公开作品。
IMAGE_CHAT_MARKET_ADMIN_TOKEN=change-me
